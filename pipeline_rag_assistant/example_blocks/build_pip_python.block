---
language: python
framework: generic
build_tool: pip
stage_type: build
tags: python, pip, build
---
build:
  stage: build
  image: python:3.12-slim
  script:
    - pip install --no-cache-dir -r requirements.txt
    - python -m build
  artifacts:
    paths:
      - dist/*.whl
    expire_in: 1 hour
