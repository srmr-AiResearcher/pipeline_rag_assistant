---
language: any
framework: any
build_tool: kubectl
stage_type: deploy
tags: kubernetes, k8s, kubectl, deploy
---
deploy_k8s:
  stage: deploy
  image: bitnami/kubectl:latest
  script:
    - kubectl set image deployment/app-deployment app="$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA"
    - kubectl rollout status deployment/app-deployment
  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'
